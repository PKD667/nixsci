+        throw SysError("creating private user and mount namespaces; unprivileged user namespaces must be enabled");
+
+    if (mount(nullptr, "/", nullptr, MS_REC | MS_PRIVATE, nullptr) == -1)
+        throw SysError("making the execution mount namespace private");
+
+    /* Always expose the private store from a new mount-namespace root.
+       The host's logical store path is neither a prerequisite nor an input. */
+    std::filesystem::path tmpDir = createTempDir();
+
+    createDirs(tmpDir + storeDir);
+
+    if (mount(realStoreDir.c_str(), (tmpDir + storeDir).c_str(), "", MS_BIND, 0) == -1)
+        throw SysError("mounting '%s' on '%s'", realStoreDir, storeDir);
+
+    for (const auto & entry : DirectoryIterator{"/"}) {
+        checkInterrupt();
+        const auto & src = entry.path();
+        std::filesystem::path dst = tmpDir / entry.path().filename();
+        if (pathExists(dst))
+            continue;
+        auto st = entry.symlink_status();
+        if (std::filesystem::is_directory(st)) {
+            if (mkdir(dst.c_str(), 0700) == -1)
+                throw SysError("creating directory %s", PathFmt(dst));
+            if (mount(src.c_str(), dst.c_str(), "", MS_BIND | MS_REC, 0) == -1)
+                throw SysError("mounting %s on %s", PathFmt(src), PathFmt(dst));
+        } else if (std::filesystem::is_symlink(st))
+            createSymlink(readLink(src), dst);
+    }
+
+    char * cwd = getcwd(0, 0);
+    if (!cwd)
+        throw SysError("getting current directory");
+    Finally freeCwd([&]() { free(cwd); });
+
+    if (mount(tmpDir.c_str(), tmpDir.c_str(), nullptr, MS_BIND | MS_REC, nullptr) == -1)
+        throw SysError("mounting execution root %s", PathFmt(tmpDir));
+    auto oldRoot = tmpDir / ".old-root";
+    if (mkdir(oldRoot.c_str(), 0700) == -1)
+        throw SysError("creating old execution root");
+    if (syscall(SYS_pivot_root, tmpDir.c_str(), oldRoot.c_str()) == -1)
+        throw SysError("pivoting execution root %s", PathFmt(tmpDir));
+    if (chdir("/") == -1 || umount2("/.old-root", MNT_DETACH) == -1)
+        throw SysError("detaching old execution root");
+    if (rmdir("/.old-root") == -1)
+        throw SysError("removing old execution root mountpoint");
+
+    if (chdir(cwd) == -1)
+        throw SysError("chdir to '%s' in execution root", cwd);
+
+    writeFile(std::filesystem::path{"/proc/self/setgroups"}, "deny");
+    writeFile(std::filesystem::path{"/proc/self/uid_map"}, fmt("%d %d %d", 0, uid, 1));
+    writeFile(std::filesystem::path{"/proc/self/gid_map"}, fmt("%d %d %d", 0, gid, 1));
+
+    /* A root ID inside this namespace maps only to the caller. Nested
+       sandboxes can map through it; remove every setup capability before exec. */
+    auto securebits = SECBIT_NOROOT | SECBIT_NOROOT_LOCKED | SECBIT_NO_SETUID_FIXUP
+        | SECBIT_NO_SETUID_FIXUP_LOCKED | SECBIT_NO_CAP_AMBIENT_RAISE
+        | SECBIT_NO_CAP_AMBIENT_RAISE_LOCKED;
+    if (prctl(PR_SET_SECUREBITS, securebits, 0, 0, 0) == -1)
+        throw SysError("locking unprivileged execution capabilities");
+    for (unsigned int capability = 0; capability <= CAP_LAST_CAP; ++capability) {
+        auto present = prctl(PR_CAPBSET_READ, capability, 0, 0, 0);
+        if (present == -1) {
+            if (errno == EINVAL)
+                break;
+            throw SysError("reading capability bounding set");
