-    writeFile(std::filesystem::path{"/proc/self/setgroups"}, "deny");
-    writeFile(std::filesystem::path{"/proc/self/uid_map"}, fmt("%d %d %d", uid, uid, 1));
-    writeFile(std::filesystem::path{"/proc/self/gid_map"}, fmt("%d %d %d", gid, gid, 1));
+        if (present && prctl(PR_CAPBSET_DROP, capability, 0, 0, 0) == -1)
+            throw SysError("dropping capability %d from bounding set", capability);
+    }
+    if (prctl(PR_CAP_AMBIENT, PR_CAP_AMBIENT_CLEAR_ALL, 0, 0, 0) == -1)
+        throw SysError("clearing ambient capabilities");
+    struct __user_cap_header_struct capHeader{};
+    capHeader.version = _LINUX_CAPABILITY_VERSION_3;
+    struct __user_cap_data_struct capData[2]{};
+    if (syscall(SYS_capset, &capHeader, capData) == -1)
+        throw SysError("dropping setup capabilities");
+    if (prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) == -1)
+        throw SysError("preventing privilege gain on exec");
