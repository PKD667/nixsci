\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{nixsci}

\providecommand\nixsciroot{}

\newcommand{\nixscistyle}[1]{%
  \ifcsname nixsci@style@#1\endcsname
    \csname nixsci@style@#1\endcsname
  \else
    \PackageError{nixsci}{unknown nixsci style `#1'}{The toolkit knows: slides.}%
  \fi}

\newcommand{\nixsci@defval}[2]{\expandafter\def\csname nixsci@val@#1\endcsname{#2}}
\newcommand{\val}[1]{\ifcsname nixsci@val@#1\endcsname\csname nixsci@val@#1\endcsname
  \else\PackageError{nixsci}{no value `#1'}{The document's projects publish no value with this key.}\fi}

\newcommand{\nixsci@draft}[1]{\AddToHook{shipout/foreground}{\put(0.5\paperwidth,-\paperheight+4mm){%
  \makebox[0pt]{\normalfont\tiny DRAFT: #1 untraced input(s); not for publication}}}}

\newcommand{\nixsci@remeasure}[1]{\AddToHook{shipout/foreground}{\put(0.5\paperwidth,-\paperheight+8mm){%
  \makebox[0pt]{\normalfont\tiny REMEASURED: #1}}}}

\newcommand{\nixscipath}[1]{\nixsciroot nixsci/#1}
\newcommand{\nixscibib}[1]{\@ifpackageloaded{biblatex}
  {\addbibresource{\nixscipath{#1}.bib}}
  {\bibliography{\nixscipath{#1}}}}

\newcommand{\nixsciproject}[1]{\usepackage{#1}}


\newread\nixsci@in
\newcommand\nixsci@genbuf{}
\newcommand\nixsci@genname{}
\newcommand\nixsci@tclass{}
\newcommand\nixsci@tclassopts{}
\newcommand\nixsci@tmedium{}
\newcommand\nixsci@tstyle{}
\newcommand\nixsci@tuses{}
\newcommand\nixsci@tprojects{}

\IfFileExists{\nixsciroot nixsci/generated.tex}
  {\gdef\nixsci@genname{\nixsciroot nixsci/generated.tex}}
  {\IfFileExists{nixsci-generated.tex}{\gdef\nixsci@genname{nixsci-generated.tex}}{}}

\def\nixsci@slurp{%
  \gdef\nixsci@genbuf{}%
  \ifx\nixsci@genname\empty\else
    \openin\nixsci@in=\nixsci@genname\relax
    \loop\unless\ifeof\nixsci@in
      \read\nixsci@in to\nixsci@line
      \expandafter\g@addto@macro\expandafter\nixsci@genbuf\expandafter{\nixsci@line}%
    \repeat
    \closein\nixsci@in
  \fi}

\long\def\nixsci@findclass#1\nixsci@class#2#3#4\nixsci@stop{%
  \gdef\nixsci@tclass{#2}\gdef\nixsci@tclassopts{#3}}
\def\nixsci@classscan{%
  \ifx\nixsci@genbuf\empty \else
    \expandafter\nixsci@findclass\nixsci@genbuf\nixsci@class{}{}\nixsci@stop
  \fi}

\def\nixsci@class#1#2{\gdef\nixsci@tclass{#1}\gdef\nixsci@tclassopts{#2}}
\def\nixsci@medium#1{\gdef\nixsci@tmedium{#1}}
\def\nixsci@style#1{\gdef\nixsci@tstyle{#1}}
\def\nixsci@use#1#2{\g@addto@macro\nixsci@tuses{\nixsci@usepkg{#1}{#2}}}
\def\nixsci@project#1{\g@addto@macro\nixsci@tprojects{\usepackage{#1}}}
\def\nixsci@bib#1{}

\def\nixsci@usepkg#1#2{\ifx\relax#2\relax\usepackage{#1}\else\usepackage[#2]{#1}\fi}

\def\nixsci@fonts{\RequirePackage{nixsci-fonts}}

\def\nixsci@loadall{%
  \nixsci@slurp
  \nixsci@classscan
  \let\nixsci@line\relax
  \nixsci@genbuf
  \nixsci@tuses
  \nixsci@fonts
  \ifx\nixsci@tmedium\empty\else
    \ifcsname nixsci@style@\nixsci@tmedium\endcsname
      \csname nixsci@style@\nixsci@tmedium\endcsname
    \else
      \PackageError{nixsci}{unknown medium `\nixsci@tmedium'}{The toolkit knows: slides.}%
    \fi
  \fi
  \nixsci@tprojects
  \ifx\nixsci@tstyle\empty\else\usepackage{\nixsci@tstyle}\fi}

\ifx\nixsci@inclass\@undefined
  \nixsci@slurp
  \nixsci@classscan
  \nixsci@loadall
\else
  \nixsci@slurp
  \nixsci@classscan
\fi

\newcommand{\nixsci@style@slides}{%
  \providecommand{\paperfig}[2]{{\centering\rmfamily
    \renewcommand\normalsize{\fontsize{9}{11}\selectfont}\renewcommand\small{\fontsize{8}{9.5}\selectfont}
    \renewcommand\footnotesize{\fontsize{7.5}{9}\selectfont}\renewcommand\scriptsize{\fontsize{6.5}{8}\selectfont}
    \renewcommand\tiny{\fontsize{5.5}{6.5}\selectfont}\normalsize
    \setlength{\columnwidth}{##2}\input{##1}\par}}%

  \RequirePackage{natbib}
  \RequirePackage{bibentry}

  \providecommand{\nixscifootnotesize}{\fontsize{5}{6}\selectfont}
  \setbeamertemplate{footnote}{\parindent 0pt\noindent\raggedright\nixscifootnotesize\insertfootnotetext\par}

  \def\showURL##1{\unskip}

  \newcommand{\citehere}[2][]{\begingroup\renewcommand{\thefootnote}{}\footnote{\ifx\relax##1\relax\citeauthor{##2}~\citeyear{##2}\else\bibentry{##2}\fi}\endgroup}}
